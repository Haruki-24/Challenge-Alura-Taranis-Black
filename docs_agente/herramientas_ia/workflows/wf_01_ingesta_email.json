{
  "name": "WF-01 Ingesta de Email - Taranis Black",
  "nodes": [
    {
      "parameters": {
        "mailbox": "INBOX",
        "options": {}
      },
      "id": "imap-trigger",
      "name": "IMAP Trigger",
      "type": "n8n-nodes-base.emailReadImap",
      "typeVersion": 2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "jsCode": "const text = $json.text || $json.subject || '';\nreturn [{ json: { texto: text, remitente: $json.from, fecha: $json.date } }];"
      },
      "id": "extract-text",
      "name": "Extract Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [470, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.RAG_ENDPOINT }}/rag/clasificar",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ consulta: $json.texto }) }}"
      },
      "id": "rag-classify",
      "name": "RAG Classify",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [690, 300]
    }
  ],
  "connections": {
    "IMAP Trigger": {
      "main": [[{ "node": "Extract Text", "type": "main", "index": 0 }]]
    },
    "Extract Text": {
      "main": [[{ "node": "RAG Classify", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "meta": { "instanceId": "taranis-black-local" }
}
